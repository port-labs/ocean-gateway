# Ocean Gateway — example environment variables.
# Copy to .env and adjust. All values shown are the defaults.

# HTTP server
LISTEN_ADDR=:8080
METRICS_LISTEN_ADDR=:9100

# Redis connection
REDIS_LIVE_EVENTS_URL=localhost:6379
REDIS_LIVE_EVENTS_USERNAME=
REDIS_LIVE_EVENTS_PASSWORD=
REDIS_LIVE_EVENTS_ENABLE_TLS=false
REDIS_DB=0
# Connection pool size. 0 = go-redis default (10 × GOMAXPROCS).
# Raise this if ocean_gateway_inflight_requests is often near the pool ceiling.
REDIS_POOL_SIZE=0

# Stream retention
# Trim entries older than EVENT_TTL via XADD MINID. 0 = no age trim.
EVENT_TTL=6h
# Refresh each stream key's EXPIRE on every write; idle streams are deleted.
# 0 = no expiry.
STREAM_TTL=720h
# Approx MAXLEN per stream, size-based trim. Ignored when EVENT_TTL > 0. 0 = uncapped.
REDIS_STREAM_MAXLEN=0

# Write retry policy (per request, synchronous)
WRITE_MAX_RETRIES=2
WRITE_BACKOFF_BASE=50ms
